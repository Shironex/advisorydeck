---
import { href } from '../lib/site.ts';

interface Props {
  items: { label: string; path?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {items.map((item, i) =>
      item.path !== undefined && i < items.length - 1 ? (
        <li>
          <a href={href(item.path)}>{item.label}</a>
        </li>
      ) : (
        <li aria-current="page">{item.label}</li>
      ),
    )}
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-1);
    color: var(--color-border-strong);
  }
  .crumbs a {
    color: var(--color-text-muted);
  }
</style>
