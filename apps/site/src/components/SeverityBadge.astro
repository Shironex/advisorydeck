---
import type { SeverityView } from '../lib/feed.ts';

interface Props {
  severity: SeverityView;
  /** Show the CVSS score next to the level. */
  withScore?: boolean;
}

const { severity, withScore = true } = Astro.props;
const label =
  severity.level === 'unknown'
    ? 'Unknown'
    : severity.level[0]?.toUpperCase() + severity.level.slice(1);
---

<span class="sev" data-level={severity.level}>
  <span class="sev-level">{label}</span>
  {withScore && severity.score !== null && (
    <span class="sev-score">{severity.score.toFixed(1)}</span>
  )}
</span>

<style>
  .sev {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: 1.6;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    background: var(--sev-unknown-bg);
    color: var(--sev-unknown-fg);
  }
  .sev-score {
    font-weight: var(--weight-normal);
  }
  .sev[data-level='critical'] {
    background: var(--sev-critical-bg);
    color: var(--sev-critical-fg);
  }
  .sev[data-level='high'] {
    background: var(--sev-high-bg);
    color: var(--sev-high-fg);
  }
  .sev[data-level='medium'] {
    background: var(--sev-medium-bg);
    color: var(--sev-medium-fg);
  }
  .sev[data-level='low'] {
    background: var(--sev-low-bg);
    color: var(--sev-low-fg);
  }
</style>
