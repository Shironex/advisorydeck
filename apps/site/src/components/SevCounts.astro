---
import { SEVERITY_ORDER, type SeverityLevel } from '../lib/feed.ts';
import Sev from './Sev.astro';

interface Props {
  counts: Record<SeverityLevel, number>;
}

const { counts } = Astro.props;
---

<span class="sev-counts">
  {SEVERITY_ORDER.filter((level) => counts[level] > 0).map((level) => (
    <Sev level={level} label={`${counts[level]} ${level}`} />
  ))}
</span>
