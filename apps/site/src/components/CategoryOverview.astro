---
import { CATEGORY_LABELS, categoriesInUse, loadSiteData, productsIn } from '../lib/feed.ts';
import { categoryPath, href, productPath } from '../lib/site.ts';

const data = loadSiteData();
const categories = categoriesInUse(data);
---

<div class="cats">
  {categories.map((category) => (
    <section class="cat" aria-labelledby={`cat-${category}`}>
      <h3 id={`cat-${category}`}>
        <a href={href(categoryPath(category))}>{CATEGORY_LABELS[category].name}</a>
      </h3>
      <ul>
        {productsIn(data, category).map((p) => (
          <li>
            <a href={href(productPath(p.slug))}>{p.name}</a>
            <span class="muted small">
              {p.advisoryIds.length}
              <span class="visually-hidden"> advisories</span>
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-4);
  }
  .cat h3 {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    margin: 0 0 var(--space-1);
  }
  .cat h3 a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .cat h3 a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-1);
    border-bottom: var(--border-width) solid var(--color-border);
  }
</style>
