---
import type { NoteView } from '../lib/feed.ts';
import { renderNoteMarkdown } from '../lib/markdown.ts';
import { REPO_URL, requestNoteUrl, wrongNoteUrl } from '../lib/site.ts';

interface Props {
  note: NoteView | null;
  advisoryId: string;
  products: string[];
}

const { note, advisoryId, products } = Astro.props;

const EXPOSURE: Record<NoteView['exposure'], { label: string; tone: string }> = {
  'default-exposed': { label: 'Exposed on a default setup', tone: 'danger' },
  conditional: { label: 'Exposed only in some setups', tone: 'warn' },
  'not-default': { label: 'Not exposed on a default setup', tone: 'ok' },
  unknown: { label: 'Exposure unknown: go by the vendor severity', tone: 'info' },
};

const ACTION_LABELS: Record<string, string> = {
  upgrade: 'Upgrade',
  backup: 'Back up first',
  commands: 'Run',
  config: 'Change the configuration',
  restart: 'Restart',
  read: 'Read',
};

const AUTHORSHIP: Record<NoteView['authorship'], string> = {
  human: 'Written by a person',
  'model-drafted-human-reviewed':
    'Drafted with a language model, then edited and reviewed by a person',
  'model-drafted': 'Drafted by a language model, not reviewed',
};

const STATE_LABEL: Record<NoteView['state'], string> = {
  reviewed: 'Reviewed',
  draft: 'Unreviewed draft: do not rely on it',
  disputed: 'Disputed',
  superseded: 'Superseded',
};

const showExposure = note !== null && note.state !== 'disputed';
const exposure = note === null ? null : EXPOSURE[note.exposure];
---

<section class="note" data-state={note?.state ?? 'none'} aria-labelledby="note-heading">
  <div class="note-head">
    <h2 id="note-heading">Self-hoster note</h2>
    {note && <span class="note-state">{STATE_LABEL[note.state]}</span>}
  </div>

  {note === null ? (
    <div class="note-empty">
      <p>
        No reviewed note for this advisory yet. The facts above come straight from the sources;
        nobody has judged yet whether a typical self-hosted setup is exposed.
      </p>
      <p class="small">
        <a href={requestNoteUrl(advisoryId, products)}>Propose or request a note</a> ·{' '}
        <a href={`${REPO_URL}/blob/main/docs/adding-a-note.md`}>How notes are written</a>
      </p>
    </div>
  ) : (
    <div class="note-body">
      {note.state === 'draft' && (
        <p class="note-banner" role="note">
          This is an unreviewed draft. It may be wrong. It is not sent by the notifier image and is
          shown only so it can be checked.
        </p>
      )}
      {note.state === 'disputed' && (
        <p class="note-banner" data-tone="warn" role="note">
          Someone reported this note as wrong and it is being checked. Its exposure assessment is
          hidden until then; go by the vendor advisory and the severity above.
        </p>
      )}
      {note.state === 'superseded' && (
        <p class="note-banner" role="note">
          Kept for history: newer information replaced this note. Go by the vendor advisory.
        </p>
      )}

      {showExposure && exposure && (
        <div class="exposure">
          <p class="exposure-label">
            <span class="tag" data-tone={note.state === 'reviewed' ? exposure.tone : undefined}>
              {exposure.label}
            </span>
          </p>
          {note.assumptions.length > 0 ? (
            <div class="assumptions">
              <p class="assumptions-lead">This holds only if all of these are true for you:</p>
              <ul>
                {note.assumptions.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          ) : (
            <p class="assumptions-lead">No assumptions: this applies to every setup.</p>
          )}
        </div>
      )}

      <div class="note-text" set:html={renderNoteMarkdown(note.body)} />

      {note.actions.length > 0 && (
        <>
          <h3>What to do</h3>
          <ol class="actions">
            {note.actions.map((action) => (
              <li>
                <strong>{ACTION_LABELS[action.kind] ?? action.kind}</strong>
                {action.text && <span>: {action.text}</span>}
                {action.code && <pre><code>{action.code.replace(/\n$/, '')}</code></pre>}
              </li>
            ))}
          </ol>
        </>
      )}

      <dl class="facts note-meta small">
        {note.state === 'reviewed' || note.reviewedBy ? (
          <>
            <dt>Reviewed</dt>
            <dd>
              {note.reviewedBy ? `by ${note.reviewedBy}` : 'reviewer not named'}
              {note.reviewedAt && (
                <>
                  {' '}
                  on <time datetime={note.reviewedAt}>{note.reviewedAt}</time>
                </>
              )}
            </dd>
          </>
        ) : (
          <>
            <dt>Reviewed</dt>
            <dd>Not yet</dd>
          </>
        )}
        {note.writtenBy && (
          <>
            <dt>Written by</dt>
            <dd>{note.writtenBy}</dd>
          </>
        )}
        <dt>Authorship</dt>
        <dd>{AUTHORSHIP[note.authorship]}</dd>
        <dt>Audience</dt>
        <dd>
          {note.audience === 'coolify-selfhosters'
            ? 'Coolify self-hosters'
            : 'Self-hosters in general'}
        </dd>
      </dl>
      <p class="small note-report">
        <a href={wrongNoteUrl(advisoryId)}>Report a wrong note</a> (GitHub issue form). Notes are
        licensed CC-BY-4.0.
      </p>
    </div>
  )}
</section>

<style>
  .note {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-4);
    margin-block: var(--space-5);
    box-shadow: var(--shadow-raised);
  }
  .note-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .note-head h2 {
    margin: 0;
  }
  .note-state {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--state-draft-bg);
    color: var(--state-draft-fg);
  }
  .note[data-state='reviewed'] .note-state {
    background: var(--state-ok-bg);
    color: var(--state-ok-fg);
  }
  .note[data-state='disputed'] .note-state {
    background: var(--state-warn-bg);
    color: var(--state-warn-fg);
  }
  .note[data-state='draft'],
  .note[data-state='superseded'] {
    background: var(--color-surface-muted);
    border-style: dashed;
  }
  .note[data-state='draft'] .note-text,
  .note[data-state='superseded'] .note-text,
  .note[data-state='disputed'] .note-text,
  .note[data-state='disputed'] .actions {
    color: var(--color-text-muted);
  }
  .note-banner {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--state-draft-bg);
    color: var(--state-draft-fg);
    font-size: var(--text-sm);
  }
  .note-banner[data-tone='warn'] {
    background: var(--state-warn-bg);
    color: var(--state-warn-fg);
  }
  .exposure {
    border-left: 3px solid var(--color-border-strong);
    padding-left: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .exposure-label {
    margin-bottom: var(--space-2);
  }
  .exposure-label .tag {
    font-size: var(--text-sm);
    white-space: normal;
  }
  .assumptions-lead {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }
  .assumptions ul {
    margin: 0;
    padding-left: var(--space-5);
  }
  .actions {
    padding-left: var(--space-5);
  }
  .actions li {
    margin-bottom: var(--space-2);
  }
  .actions pre {
    margin-top: var(--space-2);
  }
  .note-meta {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--color-border);
  }
  .note-report {
    margin: var(--space-3) 0 0;
  }
</style>
