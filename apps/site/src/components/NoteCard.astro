---
import type { NoteView } from '../lib/feed.ts';
import { shortDate } from '../lib/format.ts';
import { renderNoteMarkdown } from '../lib/markdown.ts';
import { REPO_URL, requestNoteUrl, wrongNoteUrl } from '../lib/site.ts';
import Icon from './Icon.astro';

/** The curated note in its state. A dashed border always means draft and nothing else. */
interface Props {
  note: NoteView | null;
  advisoryId: string;
  products: string[];
  labelledBy: string;
}

const { note, advisoryId, products, labelledBy } = Astro.props;

const EXPOSURE: Record<NoteView['exposure'], string> = {
  'default-exposed': 'Exposed on a default setup',
  conditional: 'Conditional',
  'not-default': 'Not exposed on a default setup',
  unknown: 'Unknown: go by the vendor severity',
};

const ACTION_LABELS: Record<string, string> = {
  upgrade: 'Upgrade',
  backup: 'Back up first',
  commands: 'Run',
  config: 'Change the configuration',
  restart: 'Restart',
  read: 'Read',
};

const AUTHORSHIP: Record<NoteView['authorship'], string> = {
  human: 'Written by a person.',
  'model-drafted-human-reviewed':
    'Drafted with a language model, then edited and reviewed by a person.',
  'model-drafted': 'Drafted by a language model, not reviewed.',
};

const showExposure = note !== null && note.state !== 'disputed';
const reviewed = note !== null && (note.reviewedBy !== null || note.state === 'reviewed');
---

{note === null ? (
  <div class="empty" data-state="none">
    <p class="empty-title">No curated note yet</p>
    <p>
      No reviewed note for this advisory yet. The facts above come straight from the sources; nobody
      has judged yet whether a typical self-hosted setup is exposed.{' '}
      <a href={requestNoteUrl(advisoryId, products)}>Write or request one</a> or read{' '}
      <a href={`${REPO_URL}/blob/main/docs/adding-a-note.md`}>how notes are written</a>.
    </p>
  </div>
) : (
  <article
    class:list={['note', note.state === 'draft' ? 'note--draft' : 'note--reviewed']}
    data-state={note.state}
    aria-labelledby={labelledBy}
  >
    <div class="note-head">
      {note.state === 'draft' && <span class="tag tag--draft">Draft, not reviewed</span>}
      {note.state === 'reviewed' && (
        <span class="tag tag--reviewed">
          <Icon name="check" class="icon--tag" />
          Reviewed
        </span>
      )}
      {note.state === 'disputed' && <span class="tag">Disputed</span>}
      {note.state === 'superseded' && <span class="tag">Superseded</span>}
      <span>
        {note.state === 'draft' ? (
          'Unreviewed draft: do not rely on it. Drafts are never sent by the notifier.'
        ) : reviewed ? (
          <>
            Reviewed by {note.reviewedBy ?? 'a maintainer'}
            {note.reviewedAt && (
              <>
                {' '}
                on <time datetime={note.reviewedAt}>{shortDate(note.reviewedAt)}</time>
              </>
            )}
            .
          </>
        ) : (
          'Not reviewed yet.'
        )}{' '}
        {note.writtenBy ? `Written by ${note.writtenBy}.` : AUTHORSHIP[note.authorship]}
      </span>
    </div>
    {note.state === 'disputed' && (
      <p class="note-banner">
        Someone reported this note as wrong and it is being checked. Its exposure assessment is
        hidden until then; go by the vendor advisory and the severity above.
      </p>
    )}
    {note.state === 'superseded' && (
      <p class="note-banner">
        Kept for history: newer information replaced this note. Go by the vendor advisory.
      </p>
    )}
    {showExposure && (
      <div class="exposure">
        <div>
          <p class="exposure-label">Exposure</p>
          <p class="exposure-value">{EXPOSURE[note.exposure]}</p>
        </div>
        <div>
          <p class="exposure-label">
            {note.assumptions.length > 0 ? 'Assumes, all of these true for you' : 'Assumes'}
          </p>
          {note.assumptions.length > 0 ? (
            <ul>
              {note.assumptions.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          ) : (
            <p class="exposure-none">Nothing: this applies to every setup.</p>
          )}
        </div>
      </div>
    )}
    <div class="note-body" set:html={renderNoteMarkdown(note.body)} />
    {note.actions.length > 0 && (
      <ol class="actions" aria-label="What to do">
        {note.actions.map((action) => (
          <li>
            <span>
              <strong>{ACTION_LABELS[action.kind] ?? action.kind}</strong>
              {action.text && <>: {action.text}</>}
              {action.code && <pre
                class="code note-code"
                tabindex="0"
                aria-label={`Commands: ${ACTION_LABELS[action.kind] ?? action.kind}`}
              ><code>{action.code.replace(/\n$/, '')}</code></pre>}
            </span>
          </li>
        ))}
      </ol>
    )}
    <p class="note-foot">
      <a href={wrongNoteUrl(advisoryId)}>Report a wrong note</a>
      <span>
        Audience:{' '}
        {note.audience === 'coolify-selfhosters'
          ? 'Coolify self-hosters'
          : 'self-hosters in general'}
      </span>
      <span>Notes are CC-BY-4.0</span>
    </p>
  </article>
)}
