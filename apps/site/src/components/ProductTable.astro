---
import { advisoriesOf, countBySeverity, loadSiteData, type ProductView } from '../lib/feed.ts';
import { href, productPath } from '../lib/site.ts';

interface Props {
  products: readonly ProductView[];
  label: string;
}

const { products, label } = Astro.props;
const data = loadSiteData();
const rows = products.map((product) => {
  const advisories = advisoriesOf(data, product.advisoryIds);
  return {
    product,
    total: advisories.length,
    counts: countBySeverity(advisories),
    supported: product.branches.filter((b) => !b.eol).map((b) => b.name),
  };
});
---

<div class="table-wrap" tabindex="0" role="region" aria-label={`${label}, scrolls sideways`}>
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Product</th>
        <th scope="col" class="num">
          Advisories
        </th>
        <th scope="col" class="num">
          <span class="sev" data-sev="critical">
            Critical
          </span>
        </th>
        <th scope="col" class="num">
          <span class="sev" data-sev="high">
            High
          </span>
        </th>
        <th scope="col">Supported branches</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(({ product, total, counts, supported }) => (
        <tr>
          <th scope="row">
            <a href={href(productPath(product.slug))}>{product.name}</a>
          </th>
          <td class="num">{total}</td>
          <td class="num">{counts.critical}</td>
          <td class="num">{counts.high}</td>
          <td>
            {supported.length > 0 ? (
              <span class="mono">{supported.join(', ')}</span>
            ) : (
              'No branch data'
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
