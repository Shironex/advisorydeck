---
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-500.css';
import '@fontsource/geist/latin-600.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/tokens.css';
import '../styles/site.css';
import SideNav from '../components/SideNav.astro';
import TopBar, { type Section } from '../components/TopBar.astro';
import { href, REPO_URL, SITE_NAME } from '../lib/site.ts';

interface Props {
  title: string;
  description: string;
  /** Top nav item to mark current. */
  section?: Section;
  /** Product whose page this is, marked in the side nav. */
  product?: string;
  /** content: the 1000 px column; wide: 1120 px; none: the page lays out its own column. */
  width?: 'content' | 'wide' | 'none';
  /** Atom feed of this page, a site path. */
  feed?: { path: string; title: string };
}

const { title, description, section, product, width = 'content', feed } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={`${SITE_NAME}: all advisories`}
      href={href('feed.xml')}
    />
    {feed && (
      <link rel="alternate" type="application/atom+xml" title={feed.title} href={href(feed.path)} />
    )}
    <script is:inline>
      // A saved theme wins before first paint; without one the system setting decides.
      try {
        const theme = localStorage.getItem('ad-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        /* no storage: follow the system */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <TopBar section={section} />
    <div class="shell">
      <SideNav current={product} />
      <main class="main" id="main" tabindex="-1">
        {width === 'none' ? (
          <slot />
        ) : (
          <div class:list={['content', width === 'wide' && 'content--wide']}>
            <slot />
          </div>
        )}
        <footer class="footer">
          <p>
            Advisory data keeps the terms of its source. Curated notes CC-BY-4.0, code MIT. Best
            effort, no warranty: always read the vendor advisory.
          </p>
          <nav aria-label="Footer">
            <a href={href('sources/')}>Sources</a>
            <a href={href('feed.xml')}>Atom feed</a>
            <a href={href('api/v1/manifest.json')}>Feed JSON</a>
            <a href={REPO_URL}>GitHub</a>
          </nav>
        </footer>
      </main>
    </div>
  </body>
</html>
