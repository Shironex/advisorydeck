---
import '../styles/tokens.css';
import '../styles/base.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { loadSiteData } from '../lib/feed.ts';
import { isoDay } from '../lib/format.ts';
import { href, REPO_URL, SITE_NAME } from '../lib/site.ts';

interface Props {
  title: string;
  description: string;
  /** Section the page belongs to, for the current nav item. */
  section?: 'latest' | 'products' | 'generator' | 'sources' | 'advisories';
  /** Atom feed of this page, a site path. */
  feed?: { path: string; title: string };
}

const { title, description, section, feed } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const data = loadSiteData();
const nav = [
  { key: 'latest', label: 'Latest', path: '' },
  { key: 'products', label: 'Products', path: 'products/' },
  { key: 'generator', label: 'Notifier setup', path: 'generator/' },
  { key: 'sources', label: 'Data sources', path: 'sources/' },
] as const;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={`${SITE_NAME}: all advisories`}
      href={href('feed.xml')}
    />
    {feed && (
      <link rel="alternate" type="application/atom+xml" title={feed.title} href={href(feed.path)} />
    )}
    <script is:inline>
      // Apply a saved theme before first paint. Storage can be unavailable; then the system setting wins.
      try {
        const theme = localStorage.getItem('advisorydeck-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        /* no storage: follow the system */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={href('')} aria-label={`${SITE_NAME}, latest advisories`}>
          <svg class="brand-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <rect x="1" y="2" width="14" height="3" rx="1"></rect>
            <rect x="1" y="6.5" width="14" height="3" rx="1" opacity="0.7"></rect>
            <rect x="1" y="11" width="14" height="3" rx="1" opacity="0.45"></rect>
          </svg>
          <span>{SITE_NAME}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={href(item.path)} aria-current={section === item.key ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <p>
          Best effort, no warranty. Always read the vendor advisory first; a note here supplements
          it and never replaces it.
        </p>
        <p>
          Feed data updated{' '}
          <time datetime={data.generatedAt ?? ''}>
            {data.generatedAt ? isoDay(data.generatedAt) : 'never'}
          </time>
          . Code MIT, curated notes CC-BY-4.0, advisory data under each{' '}
          <a href={href('sources/')}>source's terms</a>.
        </p>
        <ul class="footer-links">
          <li>
            <a href={href('feed.xml')}>Atom feed</a>
          </li>
          <li>
            <a href={href('api/v1/manifest.json')}>JSON feed (api/v1)</a>
          </li>
          <li>
            <a href={REPO_URL}>Source on GitHub</a>
          </li>
          <li>
            <a href={`${REPO_URL}/blob/main/docs/adding-a-note.md`}>Write a note</a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-2);
    top: -10rem;
    z-index: 10;
    background: var(--color-surface);
    color: var(--color-link);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border-strong);
  }
  .skip:focus {
    top: var(--space-2);
  }
  .site-header {
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }
  .header-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    min-height: 3.25rem;
    padding-block: var(--space-2);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    color: var(--color-text);
    text-decoration: none;
  }
  .brand-mark {
    width: 1.1rem;
    height: 1.1rem;
    fill: var(--sev-high-bar);
  }
  .site-nav {
    flex: 1 1 auto;
    order: 3;
    width: 100%;
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    padding-block: var(--space-1);
    display: inline-block;
  }
  .site-nav a:hover {
    color: var(--color-text);
  }
  .site-nav a[aria-current='page'] {
    color: var(--color-text);
    box-shadow: inset 0 -2px 0 var(--color-text);
  }
  @media (min-width: 44rem) {
    .site-nav {
      order: 0;
      width: auto;
    }
  }
  main {
    padding-block: var(--space-6) var(--space-7);
    outline: none;
  }
  .site-footer {
    border-top: var(--border-width) solid var(--color-border);
    padding-block: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .footer-grid p {
    max-width: var(--prose-width);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
