---
import Base from '../layouts/Base.astro';
import { ATTRIBUTIONS } from '../lib/attribution.ts';
import { href, REPO_URL } from '../lib/site.ts';

const rows = [
  {
    ...ATTRIBUTIONS.cve,
    use: 'The primary record of each CVE. Vendors that are their own CNA (PostgreSQL, GitHub-assigned projects) publish affected and fixed versions here.',
    feedCode: 'CVE-TOU',
  },
  {
    ...ATTRIBUTIONS.ghsa,
    use: 'GitHub security advisories of the repositories in the catalog (Traefik, Coolify, Redis, Moby) and the GitHub Advisory Database entries for their packages.',
    feedCode: 'CC-BY-4.0',
  },
  {
    ...ATTRIBUTIONS.endoflife,
    use: 'Release branches, their latest release and end-of-life dates.',
    feedCode: 'MIT',
  },
  {
    ...ATTRIBUTIONS.kev,
    use: 'Whether a CVE is known to be exploited, and since when. Every advisory says "in KEV", "not in KEV" or, when the catalog could not be read, "not checked".',
    feedCode: 'CC0-1.0',
  },
  {
    ...ATTRIBUTIONS.epss,
    use: 'The probability that a CVE is exploited in the next 30 days, with its percentile and the date it was scored (scores are refreshed about daily, so the date can be a few days old).',
    feedCode: 'FIRST-EPSS',
  },
  {
    ...ATTRIBUTIONS.nvd,
    use: 'A CVSS score for CVEs that neither the vendor CNA nor GitHub scored. Nothing else is taken from NVD.',
    feedCode: 'NVD-TOU',
  },
];
---

<Base
  title="Data sources and licenses"
  description="Where Advisorydeck's advisory data comes from and the terms it is used under."
  section="sources"
>
  <header>
    <h1 class="page-title">Data sources and licenses</h1>
    <p class="lede">
      Advisorydeck republishes public advisory data. Every advisory page and every advisory in the
      JSON feed lists the exact records it was built from, with a link and the license or terms of
      each record. The full attribution text is in
      <a href={`${REPO_URL}/blob/main/NOTICE`}>NOTICE</a>.
    </p>
  </header>

  <section class="section" aria-labelledby="upstream-heading">
    <h2 class="section-title section-title--gap" id="upstream-heading">
      Upstream sources
    </h2>
    {rows.map((row) => (
      <article class="source" aria-labelledby={`src-${row.feedCode}`}>
        <h3 class="source-title" id={`src-${row.feedCode}`}>
          <a href={row.url} rel="noopener noreferrer">
            {row.name}
          </a>
        </h3>
        <p class="prose">{row.use}</p>
        <dl class="facts facts--two">
          <div>
            <dt>Terms</dt>
            <dd>
              <a href={row.licenseUrl} rel="noopener noreferrer">
                {row.license}
              </a>
            </dd>
          </div>
          <div>
            <dt>In the feed</dt>
            <dd>
              <code>license: "{row.feedCode}"</code>
            </dd>
          </div>
          <div>
            <dt>Credit</dt>
            <dd>{row.credit}</dd>
          </div>
        </dl>
      </article>
    ))}
  </section>

  <section class="section" aria-labelledby="ours-heading">
    <h2 class="section-title section-title--gap" id="ours-heading">
      Advisorydeck's own content
    </h2>
    <ul class="prose plain-list">
      <li>
        Code: <a href={`${REPO_URL}/blob/main/LICENSE`}>MIT</a>.
      </li>
      <li>
        Curated self-hoster notes: <a href={`${REPO_URL}/blob/main/notes/LICENSE`}>CC-BY-4.0</a>.
        Reuse them with credit to "Advisorydeck contributors" and a link to the note.
      </li>
      <li>
        Version ranges are normalized from the sources above; the judgement calls on ambiguous
        records are listed on each advisory page and in{' '}
        <code class="code-inline">data/quality.json</code>.
      </li>
      <li>
        Fonts: Geist and Geist Mono, self-hosted with the site, under the SIL Open Font License 1.1.
      </li>
    </ul>
  </section>

  <section class="section" aria-labelledby="not-heading">
    <h2 class="section-title section-title--gap" id="not-heading">
      What is not used
    </h2>
    <div class="prose">
      <p>
        Nothing under a non-commercial or no-derivatives license is published. Vendor web pages are
        read by people as a cross-check and to decide when a note is needed; their text is not
        copied. When the KEV catalog could not be read for an advisory, it says "not checked"
        instead of implying the CVE is not exploited.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="feed-heading">
    <h2 class="section-title section-title--gap" id="feed-heading">
      The feed
    </h2>
    <div class="prose">
      <p>
        The machine-readable feed is published at{' '}
        <a href={href('api/v1/manifest.json')}>api/v1/manifest.json</a>
        with one file per product under <code class="code-inline">api/v1/products/</code>. Its
        format is described in the
        <a href={`${REPO_URL}/blob/main/docs/feed-contract.md`}>feed contract</a>. Atom feeds:
        <a href={href('feed.xml')}>all advisories</a>, and one per product on each product page.
      </p>
      <p>
        No accounts, no analytics, no cookies, no third-party requests. The notifier image downloads
        these public files and matches locally, so this site never learns what you run.
      </p>
    </div>
  </section>
</Base>
