---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { loadSiteData } from '../lib/feed.ts';
import { CHANNEL_TYPES, DEFAULT_ENV, ENV_NAME_HELP } from '../lib/generator.ts';
import { feedBaseUrl, REPO_URL } from '../lib/site.ts';

const data = loadSiteData();

/** What the browser script needs: products with their branches and image, and the feed URL. */
const payload = {
  feedUrl: feedBaseUrl(),
  products: data.products.map((p) => ({
    slug: p.slug,
    name: p.name,
    branches: p.branches.map((b) => ({ name: b.name, eol: b.eol, latest: b.latest })),
    image: p.images[0]?.ref.replace(/^docker\.io\/(library\/)?/, '') ?? null,
  })),
};

const CHANNEL_NAMES = { discord: 'Discord', slack: 'Slack', webhook: 'Generic webhook' } as const;
const severities = ['low', 'medium', 'high', 'critical'] as const;
const modes = [
  { value: 'instant', label: 'Instant' },
  { value: 'digest', label: 'Daily digest' },
  { value: 'both', label: 'Both' },
] as const;
const files = [
  { key: 'config', file: 'advisorydeck.yml' },
  { key: 'compose', file: 'compose.yml' },
  { key: 'env', file: '.env' },
] as const;
---

<Base
  title="Notifier config"
  description="Generate advisorydeck.yml, compose.yml and a .env template for the Advisorydeck notifier, entirely in your browser."
  section="generator"
  width="wide"
>
  <header>
    <h1 class="page-title">Notifier config</h1>
    <p class="lede">Pick what you run and where alerts should go. The files update as you type.</p>
    <p class="privacy">
      <Icon name="lock" />
      Runs in your browser. Nothing you enter is sent anywhere.
    </p>
  </header>

  <noscript>
    <div class="empty gen-noscript">
      <p class="empty-title">The generator needs JavaScript</p>
      <p>
        Without it, start from the example
        <a href={`${REPO_URL}/blob/main/docs/examples/compose.yml`}>compose.yml</a> and
        <a href={`${REPO_URL}/blob/main/fixtures/image/advisorydeck.yml`}>advisorydeck.yml</a>, and
        read <a href={`${REPO_URL}/blob/main/docs/image.md`}>how the image works</a>.
      </p>
    </div>
  </noscript>

  <script
    is:inline
    type="application/json"
    id="generator-data"
    set:html={JSON.stringify(payload).replace(/</g, '\\u003c')}
  />
  {data.products.map((p) => (
    <datalist id={`branches-${p.slug}`}>
      {p.branches.map((b) => (
        <option value={b.name}>{b.eol ? 'end of life' : `latest ${b.latest ?? ''}`}</option>
      ))}
    </datalist>
  ))}
  <datalist id="time-zones"></datalist>

  <div class="gen" data-generator hidden>
    <form class="gen-form" aria-label="Notifier settings" novalidate>
      <fieldset class="gen-group">
        <legend>What you run</legend>
        <ul class="prod-list" data-products></ul>
        <p class="error-text" id="products-error" data-products-error hidden>
          <Icon name="error" />
          Pick at least one product.
        </p>
        <button class="btn gen-add" type="button" data-add-product>
          <Icon name="plus" />
          Add a product
        </button>
        <template data-product-template>
          <li class="prod">
            <div class="field">
              <label class="label" data-for="product">
                Product
              </label>
              <select class="select" data-product>
                {data.products.map((p) => (
                  <option value={p.slug}>{p.name}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label class="label" data-for="version" data-version-label>
                Version
              </label>
              <input
                class="input mono"
                data-version
                autocomplete="off"
                spellcheck="false"
                inputmode="text"
              />
            </div>
            <button class="icon-btn remove" type="button" data-remove-product>
              <Icon name="x" />
            </button>
            <div class="pin">
              <fieldset>
                <legend class="visually-hidden" data-pin-legend>
                  How you pin it
                </legend>
                <div class="seg">
                  <label>
                    <input type="radio" value="exact" data-kind />
                    <span>Exact version</span>
                  </label>
                  <label>
                    <input type="radio" value="floating" data-kind />
                    <span>I pull the floating tag</span>
                  </label>
                </div>
              </fieldset>
              <span class="hint" data-hint></span>
            </div>
            <p class="error-text prod-error" data-error hidden>
              <Icon name="error" />
              <span data-error-text></span>
            </p>
          </li>
        </template>
      </fieldset>

      <fieldset class="gen-group">
        <legend>Lowest severity to post</legend>
        <div class="seg">
          {severities.map((s) => (
            <label>
              <input type="radio" name="severity" value={s} checked={s === 'high'} />
              <span class="sev" data-sev={s}>
                {s.charAt(0).toUpperCase() + s.slice(1)}
              </span>
            </label>
          ))}
        </div>
        <p class="hint gen-hint">
          Advisories without a score never pass this on their own. Advisories on the KEV list always
          do.
        </p>
      </fieldset>

      <fieldset class="gen-group">
        <legend>When to post</legend>
        <div class="seg">
          {modes.map((m) => (
            <label>
              <input type="radio" name="mode" value={m.value} checked={m.value === 'digest'} />
              <span>{m.label}</span>
            </label>
          ))}
        </div>
        <div class="row-fields" data-digest-fields>
          <div class="field">
            <label class="label" for="digest-time">
              Digest time
            </label>
            <input
              class="input mono"
              id="digest-time"
              name="digest-time"
              value="08:00"
              inputmode="numeric"
              autocomplete="off"
              aria-describedby="digest-time-error"
            />
            <p class="error-text" id="digest-time-error" hidden>
              <Icon name="error" />
              Write the time as HH:MM, for example 08:00.
            </p>
          </div>
          <div class="field">
            <label class="label" for="timezone">
              Time zone
            </label>
            <input
              class="input"
              id="timezone"
              name="timezone"
              value="UTC"
              list="time-zones"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="timezone-hint"
            />
            <span class="hint" id="timezone-hint">
              IANA name, like Europe/Berlin
            </span>
          </div>
        </div>
      </fieldset>

      <fieldset class="gen-group">
        <legend>Where to post</legend>
        <p class="hint gen-hint-lead">
          The config holds only the name of an environment variable. Your webhook URL goes in{' '}
          <code class="code-inline">.env</code> on your server.
        </p>
        <ul class="chan-list">
          {CHANNEL_TYPES.map((type) => (
            <li class="chan" data-channel={type}>
              <label class="check-opt">
                <input type="checkbox" data-channel-on checked={type === 'discord'} />
                {CHANNEL_NAMES[type]}
              </label>
              <div class="field">
                <label class="label visually-hidden" for={`env-${type}`}>
                  {CHANNEL_NAMES[type]} variable name
                </label>
                <input
                  class="input mono"
                  id={`env-${type}`}
                  value={DEFAULT_ENV[type]}
                  autocomplete="off"
                  spellcheck="false"
                  data-channel-env
                />
                <p class="error-text" id={`env-${type}-error`} hidden>
                  <Icon name="error" />
                  {ENV_NAME_HELP}
                </p>
              </div>
            </li>
          ))}
        </ul>
        <p class="error-text" id="channels-error" data-channels-error hidden>
          <Icon name="error" />
          Pick at least one channel.
        </p>
      </fieldset>
    </form>

    <section class="output" aria-label="Generated files">
      <div class="output-bar">
        <div class="tabs" role="tablist" aria-label="Files">
          {files.map((f, i) => (
            <button
              class="tab"
              role="tab"
              type="button"
              id={`tab-${f.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${f.key}`}
              tabindex={i === 0 ? '0' : '-1'}
              data-tab={f.key}
            >
              {f.file}
            </button>
          ))}
        </div>
        <div class="output-tools">
          <button class="btn btn--sm" type="button" data-copy>
            <Icon name="copy" />
            <span data-copy-label>Copy</span>
          </button>
          <button class="btn btn--sm" type="button" data-download>
            <Icon name="download" />
            Download
          </button>
        </div>
      </div>
      <p class="valid" role="status" data-valid></p>
      {files.map((f, i) => (
        <div
          role="tabpanel"
          id={`panel-${f.key}`}
          aria-labelledby={`tab-${f.key}`}
          hidden={i !== 0}
        >
          <pre
            class="code"
            tabindex="0"
            aria-label={`${f.file} contents`}
          ><code data-code={f.key} /></pre>
        </div>
      ))}
      <div class="output-foot">
        <ol class="steps">
          <li>
            <span>
              Save <code class="code-inline">advisorydeck.yml</code> and{' '}
              <code class="code-inline">compose.yml</code> in one folder, and{' '}
              <code class="code-inline">.env</code> with your webhook URLs. No image is published
              yet, so build it first:
              <br />
              <code class="code-inline cmd">
                docker build -t advisorydeck:local
                https://github.com/Shironex/advisorydeck.git#main:image
              </code>
            </span>
          </li>
          <li>
            <span>
              Check without sending:
              <br />
              <code class="code-inline cmd">
                docker compose run --rm advisorydeck once -dry-run
              </code>
            </span>
          </li>
          <li>
            <span>
              Start it: <code class="code-inline">docker compose up -d</code>
            </span>
          </li>
        </ol>
        <p class="share">
          <button class="btn btn--quiet" type="button" data-copy-link>
            Copy a link to this setup
          </button>
          <span>Your choices live after the # sign, which browsers never send to a server.</span>
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  import { startGenerator } from '../scripts/generator.ts';
  startGenerator();
</script>
