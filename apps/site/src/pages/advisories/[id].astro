---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KevTag from '../../components/KevTag.astro';
import NoteCard from '../../components/NoteCard.astro';
import SeverityBadge from '../../components/SeverityBadge.astro';
import Base from '../../layouts/Base.astro';
import { LICENSE_NAMES, SOURCE_TYPE_NAMES } from '../../lib/attribution.ts';
import { loadSiteData, type AdvisoryView, type RangeView } from '../../lib/feed.ts';
import { isoDay, percent } from '../../lib/format.ts';
import { href, productPath } from '../../lib/site.ts';

export const getStaticPaths = (() =>
  [...loadSiteData().advisories.values()].map((advisory) => ({
    params: { id: advisory.id },
    props: { advisory },
  }))) satisfies GetStaticPaths;

interface Props {
  advisory: AdvisoryView;
}

const { advisory } = Astro.props;
const vendorRefs = advisory.references.filter((r) => r.type === 'advisory');
const otherRefs = advisory.references.filter((r) => r.type !== 'advisory');
const first = advisory.affected[0];
// A reviewed note (or the warning that one is disputed) is what a self-hoster needs first, right
// after the vendor link and the summary; drafts and "no note" come after the facts.
const noteFirst = advisory.note?.state === 'reviewed' || advisory.note?.state === 'disputed';

function rangeText(range: RangeView): { from: string; to: string } {
  const from = range.introduced === '0' ? 'first release' : range.introduced;
  if (range.fixed !== null) {
    return { from, to: `fixed in ${range.fixed}` };
  }
  if (range.lastAffected !== null) {
    return { from, to: `up to and including ${range.lastAffected} (no fix named)` };
  }
  return { from, to: 'no fix yet' };
}

const REF_TYPES: Record<string, string> = {
  fix: 'Fix',
  'release-notes': 'Release notes',
  report: 'Report',
  article: 'Article',
  web: 'Web',
};
---

<Base
  title={`${advisory.id}: ${advisory.title}`}
  description={`${advisory.id} (${advisory.severity.level}): ${advisory.title}. Affected and fixed versions for ${advisory.affected.map((a) => a.name).join(', ')}.`}
  section="latest"
>
  <Breadcrumbs
    items={[
      { label: 'Products', path: 'products/' },
      ...(first ? [{ label: first.name, path: productPath(first.slug) }] : []),
      { label: advisory.id },
    ]}
  />

  <article class="advisory" aria-labelledby="adv-title">
    <header class="adv-head">
      <p class="eyebrow mono">{advisory.id}</p>
      <h1 id="adv-title">{advisory.title}</h1>
      <p class="head-tags">
        <SeverityBadge severity={advisory.severity} />
        <KevTag kev={advisory.kev} />
        {advisory.affected.map((a) => (
          <a class="tag" href={href(productPath(a.slug))}>
            {a.name}
          </a>
        ))}
      </p>
    </header>

    <div class="adv-grid">
      <div class="adv-main">
        {vendorRefs.length > 0 && (
          <p class="vendor-first">
            Read the vendor advisory first:{' '}
            {vendorRefs.map((r, i) => (
              <>
                {i > 0 && ', '}
                <a href={r.url} rel="noopener noreferrer">
                  {new URL(r.url).hostname}
                </a>
              </>
            ))}
          </p>
        )}

        <section aria-labelledby="summary-heading">
          <h2 id="summary-heading" class="visually-hidden">
            Summary
          </h2>
          <p class="summary prose">{advisory.summary}</p>
        </section>

        {noteFirst && (
          <NoteCard
            note={advisory.note}
            advisoryId={advisory.id}
            products={advisory.affected.map((a) => a.slug)}
          />
        )}

        <section aria-labelledby="affected-heading">
          <h2 id="affected-heading">Affected versions</h2>
          {advisory.affected.map((affected) => (
            <div class="affected">
              <h3>
                <a href={href(productPath(affected.slug))}>{affected.name}</a>
              </h3>
              {affected.ranges.length === 0 ? (
                <p class="tag" data-tone="warn">
                  Affected versions unknown: check the vendor advisory manually. This does not mean
                  not affected.
                </p>
              ) : (
                <div class="table-scroll">
                  <table class="ranges">
                    <caption class="visually-hidden">
                      Affected version ranges for {affected.name}
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Affected from</th>
                        <th scope="col">Until</th>
                      </tr>
                    </thead>
                    <tbody>
                      {affected.ranges.map((range) => {
                        const text = rangeText(range);
                        return (
                          <tr>
                            <td class="mono">{text.from}</td>
                            <td class="mono">
                              {range.fixed === null ? (
                                <span class="tag" data-tone="danger">
                                  {text.to}
                                </span>
                              ) : (
                                text.to
                              )}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          ))}
          {advisory.qualityNotes.length > 0 && (
            <aside class="quality" aria-labelledby="quality-heading">
              <h3 id="quality-heading">How the ranges were read</h3>
              <p class="small muted">
                The source data for this advisory was ambiguous. Ingest made these calls, always
                choosing the reading that reports more versions as affected:
              </p>
              <ul class="small">
                {advisory.qualityNotes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            </aside>
          )}
        </section>

        {!noteFirst && (
          <NoteCard
            note={advisory.note}
            advisoryId={advisory.id}
            products={advisory.affected.map((a) => a.slug)}
          />
        )}
      </div>

      <aside class="adv-side" aria-labelledby="facts-heading">
        <h2 id="facts-heading" class="side-heading">
          Facts
        </h2>
        <dl class="facts small">
          <dt>Severity</dt>
          <dd>
            <SeverityBadge severity={advisory.severity} />
            <span class="block muted">Source: {advisory.severity.sourceLabel}</span>
            {advisory.severity.vector && (
              <code class="block vector">{advisory.severity.vector}</code>
            )}
          </dd>
          <dt>Exploited (KEV)</dt>
          <dd>
            {advisory.kev.state === 'listed'
              ? `Yes, listed in CISA KEV${advisory.kev.addedAt ? ` since ${advisory.kev.addedAt}` : ''}`
              : advisory.kev.state === 'not-listed'
                ? 'Not listed in CISA KEV'
                : 'Not checked against CISA KEV yet'}
          </dd>
          <dt>EPSS</dt>
          <dd>
            {advisory.epss === null
              ? 'Not available'
              : `${percent(advisory.epss.score)} chance of exploitation in 30 days (percentile ${percent(advisory.epss.percentile)}, scored ${advisory.epss.date})`}
          </dd>
          <dt>Published</dt>
          <dd>
            <time datetime={advisory.publishedAt}>{isoDay(advisory.publishedAt)}</time>
          </dd>
          <dt>Modified</dt>
          <dd>
            <time datetime={advisory.modifiedAt}>{isoDay(advisory.modifiedAt)}</time>
          </dd>
          {advisory.aliases.length > 0 && (
            <>
              <dt>Also known as</dt>
              <dd>
                <ul class="plain mono">
                  {advisory.aliases.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </dd>
            </>
          )}
          {advisory.cwes.length > 0 && (
            <>
              <dt>Weakness</dt>
              <dd>
                {advisory.cwes.map((cwe, i) => (
                  <>
                    {i > 0 && ', '}
                    <a
                      href={`https://cwe.mitre.org/data/definitions/${cwe.slice(4)}.html`}
                      rel="noopener noreferrer"
                    >
                      {cwe}
                    </a>
                  </>
                ))}
              </dd>
            </>
          )}
        </dl>

        <h2 class="side-heading">Sources</h2>
        <ul class="plain small sources">
          {advisory.sources.map((s) => {
            const license = LICENSE_NAMES[s.license];
            return (
              <li>
                <a href={s.url} rel="noopener noreferrer">
                  {SOURCE_TYPE_NAMES[s.type] ?? s.type} <span class="mono">{s.id}</span>
                </a>
                <span class="block muted">
                  {license ? (
                    <a href={license.url} rel="noopener noreferrer">
                      {license.name}
                    </a>
                  ) : (
                    s.license
                  )}
                </span>
              </li>
            );
          })}
        </ul>
        {otherRefs.length > 0 && (
          <>
            <h2 class="side-heading">References</h2>
            <ul class="plain small refs">
              {otherRefs.map((r) => (
                <li>
                  <span class="muted">{REF_TYPES[r.type] ?? r.type}:</span>{' '}
                  <a href={r.url} rel="noopener noreferrer">
                    {r.url.replace(/^https:\/\//, '')}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        <p class="small muted">
          <a href={href(`sources/`)}>Data sources and licenses</a>
        </p>
      </aside>
    </div>
  </article>
</Base>

<style>
  .adv-head h1 {
    font-size: var(--text-xl);
    max-width: 48ch;
  }
  .head-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .head-tags .tag {
    text-decoration: none;
  }
  .adv-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-4);
  }
  @media (min-width: 60rem) {
    .adv-grid {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: var(--space-6);
    }
  }
  .vendor-first {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--state-info-bg);
    color: var(--state-info-fg);
    font-size: var(--text-sm);
  }
  .vendor-first a {
    color: inherit;
    font-weight: var(--weight-medium);
  }
  .summary {
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .affected h3 {
    margin-top: var(--space-4);
  }
  .ranges {
    font-size: var(--text-sm);
    max-width: 32rem;
  }
  .affected p.tag {
    white-space: normal;
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }
  .quality {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) dashed var(--color-border-strong);
    border-radius: var(--radius-md);
  }
  .quality h3 {
    margin-top: 0;
    font-size: var(--text-base);
  }
  .quality ul {
    margin: 0;
    padding-left: var(--space-5);
    overflow-wrap: anywhere;
  }
  .adv-side {
    min-width: 0;
  }
  .side-heading {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: var(--space-5) 0 var(--space-2);
  }
  .side-heading:first-child {
    margin-top: 0;
  }
  .block {
    display: block;
  }
  .vector {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sources li,
  .refs li {
    margin-bottom: var(--space-2);
    overflow-wrap: anywhere;
  }
</style>
