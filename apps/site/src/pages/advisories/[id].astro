---
import type { GetStaticPaths } from 'astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import NoteCard from '../../components/NoteCard.astro';
import Sev from '../../components/Sev.astro';
import Base from '../../layouts/Base.astro';
import { answers } from '../../lib/answer.ts';
import { LICENSE_NAMES, SOURCE_TYPE_NAMES } from '../../lib/attribution.ts';
import { CATEGORY_LABELS, loadSiteData, type AdvisoryView } from '../../lib/feed.ts';
import { dateTimeUtc, percent, shortDate } from '../../lib/format.ts';
import { categoryPath, generatorPath, href, productPath } from '../../lib/site.ts';

export const getStaticPaths = (() =>
  [...loadSiteData().advisories.values()].map((advisory) => ({
    params: { id: advisory.id },
    props: { advisory },
  }))) satisfies GetStaticPaths;

interface Props {
  advisory: AdvisoryView;
}

const { advisory } = Astro.props;
const data = loadSiteData();
const first = advisory.affected[0];
const firstProduct = data.products.find((p) => p.slug === first?.slug);
const blocks = answers(advisory, data.products);
const vendorRefs = advisory.references.filter((r) => r.type === 'advisory');
const otherRefs = advisory.references.filter((r) => r.type !== 'advisory');
const cnaRecord = advisory.sources.find((s) => s.type === 'cve-cna') ?? advisory.sources[0];
const recordLink = cnaRecord
  ? { url: cnaRecord.url, host: new URL(cnaRecord.url).hostname.replace(/^www\./, '') }
  : null;
const ranged = advisory.sources.find((s) => s.type === 'cve-cna')
  ? `Ranges from the ${first?.name ?? ''} CNA record`
  : advisory.sources.find((s) => s.type === 'ghsa')
    ? 'Ranges from the GitHub advisory'
    : 'Ranges from the source record';
const sections = [
  { id: 'ans-title', label: 'Affected versions' },
  { id: 'sum-title', label: 'Summary' },
  { id: 'det-title', label: 'Details and sources' },
  { id: 'note-title', label: 'Self-hoster note' },
  { id: 'dq-title', label: 'Data quality' },
  { id: 'src-title', label: 'Sources and licenses' },
];
const REF_TYPES: Record<string, string> = {
  fix: 'Fix',
  'release-notes': 'Release notes',
  report: 'Report',
  article: 'Article',
  web: 'Web page',
};
const cvss = advisory.severity.vector?.match(/^CVSS:(\d\.\d)/)?.[1];
const host = (url: string): string => new URL(url).hostname.replace(/^www\./, '');
---

<Base
  title={`${advisory.id}: ${advisory.title}`}
  description={`${advisory.id} (${advisory.severity.level}): ${advisory.title}. Affected and fixed versions for ${advisory.affected.map((a) => a.name).join(', ')}.`}
  section="products"
  {...(first ? { product: first.slug } : {})}
  width="none"
>
  <div class="with-rail">
    <div class="content">
      <header>
        <Crumbs
          items={[
            ...(firstProduct
              ? [
                  {
                    label: CATEGORY_LABELS[firstProduct.category].name,
                    path: categoryPath(firstProduct.category),
                  },
                ]
              : []),
            ...(first ? [{ label: first.name, path: productPath(first.slug) }] : []),
            { label: advisory.id },
          ]}
        />
        <h1 class="page-title">{advisory.title}</h1>
        <p class="meta">
          <span class="mono meta-id">{advisory.id}</span>
          <Sev level={advisory.severity.level} score={advisory.severity.score} />
          <span>
            Published <time datetime={advisory.publishedAt}>{shortDate(advisory.publishedAt)}</time>
          </span>
          {advisory.aliases.length > 0 && (
            <span class="mono">Also {advisory.aliases.join(', ')}</span>
          )}
        </p>
      </header>

      <section class="answer" aria-labelledby="ans-title">
        <div class="answer-head">
          <h2 id="ans-title">Affected versions and the fix</h2>
          <span class="section-sub">{ranged}</span>
        </div>
        {blocks.map((block) => (
          <>
            {blocks.length > 1 && (
              <h3 class="answer-product">
                <a href={href(productPath(block.slug))}>{block.name}</a>
              </h3>
            )}
            {block.unknown ? (
              <p class="answer-fix">
                Affected versions unknown: the sources do not say which versions of {block.name} are
                affected. This does not mean not affected.{' '}
                {vendorRefs[0] ? (
                  <a href={vendorRefs[0].url} rel="noopener noreferrer">
                    Check the vendor advisory
                  </a>
                ) : (
                  'Check the vendor advisory.'
                )}
              </p>
            ) : block.fixes.length === 0 ? (
              <p class="answer-fix">No fix listed yet. Read the vendor advisory for workarounds.</p>
            ) : block.fixes.length === 1 ? (
              <p class="answer-fix">
                Upgrade to <code>{block.fixes[0]}</code> or later.
              </p>
            ) : (
              <p class="answer-fix">
                Upgrade to the latest release of your branch:{' '}
                {block.fixes.map((f, i) => (
                  <>
                    {i > 0 && (i === block.fixes.length - 1 ? ' or ' : ', ')}
                    <code>{f}</code>
                  </>
                ))}
                .
              </p>
            )}
            {block.rows.length > 0 && (
              <div
                class="table-wrap"
                tabindex="0"
                role="region"
                aria-label={`Affected ranges of ${block.name}`}
              >
                <table class="table">
                  <thead>
                    <tr>
                      <th scope="col">Branch</th>
                      <th scope="col">Affected</th>
                      <th scope="col">Fixed in</th>
                    </tr>
                  </thead>
                  <tbody>
                    {block.rows.map((row) => (
                      <tr class:list={[row.eol && 'is-eol']}>
                        <th scope="row" class="branch">
                          {row.branch}
                        </th>
                        <td>
                          {row.affected.lead}
                          {row.affected.version && (
                            <>
                              {' '}
                              <span class="mono">{row.affected.version}</span>
                            </>
                          )}
                          {row.affected.tail}
                        </td>
                        <td>
                          {row.fixed ? <span class="mono">{row.fixed}</span> : 'No fix listed'}
                          {row.eol && (
                            <>
                              {' '}
                              <span class="tag tag--eol">End of life</span>
                            </>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </>
        ))}
        <div class="answer-foot">
          <p>
            {blocks
              .map((b) => b.eolNote)
              .filter(Boolean)
              .join(' ') || 'Versions are compared with the same rules the notifier uses.'}
          </p>
          {first && (
            <a class="btn btn--primary" href={href(generatorPath(first.slug))}>
              Get alerts for {first.name}
            </a>
          )}
        </div>
      </section>

      <section class="section" aria-labelledby="sum-title">
        <h2 class="section-title section-title--gap" id="sum-title">
          Summary
        </h2>
        <div class="prose summary">
          <p>{advisory.summary}</p>
        </div>
        {vendorRefs.length > 0 && (
          <p class="hint section-foot">
            Read the vendor advisory too:{' '}
            {vendorRefs.map((r, i) => (
              <>
                {i > 0 && ', '}
                <a href={r.url} rel="noopener noreferrer">
                  {host(r.url)}
                </a>
              </>
            ))}
          </p>
        )}
      </section>

      <section class="section" aria-labelledby="det-title">
        <h2 class="section-title section-title--gap" id="det-title">
          Details and sources
        </h2>
        <dl class="facts">
          <div>
            <dt>Severity</dt>
            <dd>
              <Sev level={advisory.severity.level} score={advisory.severity.score} />
            </dd>
            <dd class="src">
              {cvss ? `CVSS ${cvss}, ` : ''}
              {advisory.severity.sourceLabel}
            </dd>
          </div>
          {advisory.severity.vector && (
            <div>
              <dt>Vector</dt>
              <dd>
                <code>{advisory.severity.vector}</code>
              </dd>
              <dd class="src">{advisory.severity.sourceLabel}</dd>
            </div>
          )}
          <div>
            <dt>Known exploited (KEV)</dt>
            <dd>
              {advisory.kev.state === 'listed' ? (
                <strong>
                  Yes, listed in CISA KEV
                  {advisory.kev.addedAt ? ` since ${shortDate(advisory.kev.addedAt)}` : ''}
                </strong>
              ) : advisory.kev.state === 'not-listed' ? (
                'Not listed in CISA KEV'
              ) : (
                <span class="state-unchecked">
                  <Icon name="clock" />
                  Not checked yet
                </span>
              )}
            </dd>
            <dd class="src">
              {advisory.kev.state === 'not-checked'
                ? 'CISA KEV catalog, not yet compared'
                : 'CISA KEV catalog'}
            </dd>
          </div>
          <div>
            <dt>EPSS</dt>
            {advisory.epss === null ? (
              <dd class="muted">No score published</dd>
            ) : (
              <dd>
                {percent(advisory.epss.score)} chance of exploitation in 30 days, percentile{' '}
                {percent(advisory.epss.percentile)}
              </dd>
            )}
            <dd class="src">FIRST EPSS{advisory.epss ? `, scored ${advisory.epss.date}` : ''}</dd>
          </div>
          {advisory.cwes.length > 0 && (
            <div>
              <dt>Weakness</dt>
              <dd>
                {advisory.cwes.map((cwe, i) => (
                  <>
                    {i > 0 && ', '}
                    <a
                      href={`https://cwe.mitre.org/data/definitions/${cwe.slice(4)}.html`}
                      rel="noopener noreferrer"
                    >
                      {cwe}
                    </a>
                  </>
                ))}
              </dd>
              <dd class="src">
                {cnaRecord
                  ? (SOURCE_TYPE_NAMES[cnaRecord.type] ?? cnaRecord.type)
                  : 'Source record'}
              </dd>
            </div>
          )}
          <div>
            <dt>Published</dt>
            <dd>
              <time datetime={advisory.publishedAt}>{dateTimeUtc(advisory.publishedAt)}</time>
            </dd>
            <dd class="src">
              {recordLink ? (
                <a href={recordLink.url} rel="noopener noreferrer">
                  {recordLink.host}
                </a>
              ) : (
                'Source record'
              )}
            </dd>
          </div>
          <div>
            <dt>Last modified</dt>
            <dd>
              <time datetime={advisory.modifiedAt}>{dateTimeUtc(advisory.modifiedAt)}</time>
            </dd>
            <dd class="src">
              {recordLink ? (
                <a href={recordLink.url} rel="noopener noreferrer">
                  {recordLink.host}
                </a>
              ) : (
                'Source record'
              )}
            </dd>
          </div>
        </dl>
      </section>

      <section class="section" aria-labelledby="note-title">
        <h2 class="section-title section-title--gap" id="note-title">
          Self-hoster note
        </h2>
        <NoteCard
          note={advisory.note}
          advisoryId={advisory.id}
          products={advisory.affected.map((a) => a.slug)}
          labelledBy="note-title"
        />
      </section>

      <section class="section" aria-labelledby="dq-title">
        <h2 class="section-title section-title--gap" id="dq-title">
          Data quality
        </h2>
        {advisory.qualityNotes.length === 0 ? (
          <p class="prose small-prose">
            Ingest made no judgement calls on this record: the ranges are published as the source
            wrote them.
          </p>
        ) : (
          <div class="prose small-prose">
            <p>
              The source data was ambiguous. Ingest made these calls, always choosing the reading
              that reports more versions as affected:
            </p>
            <ul class="plain-list">
              {advisory.qualityNotes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <section class="section" aria-labelledby="src-title">
        <h2 class="section-title section-title--gap" id="src-title">
          Sources and licenses
        </h2>
        <ul class="sources">
          {advisory.sources.map((s) => {
            const license = LICENSE_NAMES[s.license];
            return (
              <li>
                <a href={s.url} rel="noopener noreferrer">
                  {SOURCE_TYPE_NAMES[s.type] ?? s.type} <span class="mono">{s.id}</span>,{' '}
                  {host(s.url)} <Icon name="ext" />
                </a>
                <span class="lic">
                  {license ? (
                    <a href={license.url} rel="noopener noreferrer">
                      {license.name}
                    </a>
                  ) : (
                    s.license
                  )}
                </span>
              </li>
            );
          })}
          {[...vendorRefs, ...otherRefs].map((r) => (
            <li>
              <a href={r.url} rel="noopener noreferrer">
                {r.type === 'advisory' ? 'Vendor advisory' : (REF_TYPES[r.type] ?? r.type)},{' '}
                {host(r.url)} <Icon name="ext" />
              </a>
              <span class="lic">Linked, not copied</span>
            </li>
          ))}
        </ul>
        <p class="hint section-foot">
          Record revision <code class="code-inline">{advisory.revision.slice(0, 15)}</code>
          <span class="visually-hidden">{advisory.revision}</span>.{' '}
          <a href={href('sources/')}>All data sources and their terms</a>
        </p>
      </section>
    </div>
    <nav class="rail" aria-label="On this page">
      <h2>On this page</h2>
      <ul>
        {sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`} aria-current={i === 0 ? 'true' : undefined}>
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</Base>

<script>
  import { startRail } from '../../scripts/rail.ts';
  startRail();
</script>
