---
import DayGroups from '../../components/DayGroups.astro';
import Filters from '../../components/Filters.astro';
import Base from '../../layouts/Base.astro';
import { advisoriesOf, loadSiteData } from '../../lib/feed.ts';
import { emptyCounts, groupFeed } from '../../lib/releases.ts';

const data = loadSiteData();
const all = advisoriesOf(data, data.advisoryOrder);
const days = groupFeed(all, data.products);
const counts = emptyCounts();
for (const advisory of all) counts[advisory.severity.level] += 1;
---

<Base
  title="All advisories"
  description="Every advisory Advisorydeck tracks, newest first, grouped by day."
  section="feed"
>
  <header>
    <h1 class="page-title">All advisories</h1>
    <p class="lede">
      Every advisory in the feed, newest first. Releases that fix several advisories are folded;
      open one to see them all.
    </p>
  </header>
  <Filters
    name="asev"
    label="Filter the list"
    counts={counts}
    total={all.length}
    select={{
      filter: 'product',
      label: 'Product',
      all: 'All products',
      options: data.products.map((p) => ({ value: p.slug, label: p.name })),
    }}
  />
  <div data-feed>
    <DayGroups days={days} openFirst={false} />
    <p class="empty" data-filter-empty hidden>
      <span class="empty-title">No advisory matches these filters</span>
      <span>Pick All to see every advisory.</span>
    </p>
  </div>
</Base>

<script>
  import { startBundles, startFilters } from '../../scripts/bundles.ts';

  startBundles();
  const form = document.querySelector<HTMLElement>('[data-filters]');
  const feed = document.querySelector<HTMLElement>('[data-feed]');
  if (form !== null && feed !== null) startFilters(form, feed);
</script>
