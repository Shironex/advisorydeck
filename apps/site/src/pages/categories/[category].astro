---
import type { GetStaticPaths } from 'astro';
import Crumbs from '../../components/Crumbs.astro';
import DayGroups from '../../components/DayGroups.astro';
import ProductTable from '../../components/ProductTable.astro';
import Base from '../../layouts/Base.astro';
import {
  advisoriesOf,
  CATEGORY_LABELS,
  categoriesInUse,
  loadSiteData,
  productsIn,
  type Category,
} from '../../lib/feed.ts';
import { groupFeed } from '../../lib/releases.ts';

export const getStaticPaths = (() =>
  categoriesInUse(loadSiteData()).map((category) => ({
    params: { category },
    props: { category },
  }))) satisfies GetStaticPaths;

interface Props {
  category: Category;
}

const { category } = Astro.props;
const data = loadSiteData();
const products = productsIn(data, category);
const ids = new Set(products.flatMap((p) => p.advisoryIds));
const latest = advisoriesOf(data, data.advisoryOrder.filter((id) => ids.has(id)).slice(0, 25));
const label = CATEGORY_LABELS[category];
---

<Base
  title={label.name}
  description={`${label.name}: ${label.blurb} Security advisories per product.`}
  section="products"
>
  <header>
    <Crumbs items={[{ label: 'Products', path: 'products/' }, { label: label.name }]} />
    <h1 class="page-title">{label.name}</h1>
    <p class="lede">{label.blurb}</p>
  </header>
  <section class="section" aria-labelledby="products-title">
    <h2 class="section-title section-title--gap" id="products-title">
      Products
    </h2>
    <ProductTable products={products} label={`${label.name} products`} />
  </section>
  <section class="section" aria-labelledby="latest-title">
    <h2 class="section-title" id="latest-title">
      Latest in {label.name.toLowerCase()}
    </h2>
    <DayGroups days={groupFeed(latest, data.products)} openFirst={false} heading={3} />
  </section>
</Base>

<script>
  import { startBundles } from '../../scripts/bundles.ts';
  startBundles();
</script>
