---
import type { GetStaticPaths } from 'astro';
import BranchTable from '../../../components/BranchTable.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Filters from '../../../components/Filters.astro';
import ReleaseBundle from '../../../components/ReleaseBundle.astro';
import VersionCheck from '../../../components/VersionCheck.astro';
import Base from '../../../layouts/Base.astro';
import { productSources } from '../../../lib/attribution.ts';
import { branchTable } from '../../../lib/branches.ts';
import {
  advisoriesOf,
  CATEGORY_LABELS,
  loadSiteData,
  type ProductView,
} from '../../../lib/feed.ts';
import { plural } from '../../../lib/format.ts';
import { emptyCounts, groupReleases } from '../../../lib/releases.ts';
import { categoryPath, href, productFeedPath } from '../../../lib/site.ts';

export const getStaticPaths = (() =>
  loadSiteData().products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))) satisfies GetStaticPaths;

interface Props {
  product: ProductView;
}

const { product } = Astro.props;
const data = loadSiteData();
const advisories = advisoriesOf(data, product.advisoryIds);
const table = branchTable(product, advisories, data.generatedAt);
const releases = groupReleases(product, advisories);
const counts = emptyCounts();
for (const advisory of advisories) counts[advisory.severity.level] += 1;
const since = data.generatedAt
  ? new Date(Date.parse(data.generatedAt) - 365 * 86_400_000).toISOString()
  : null;
const lastYear = advisories.filter((a) => since === null || a.publishedAt >= since).length;
const category = CATEGORY_LABELS[product.category];
const sources = productSources(product);
const primary = sources[0];
const branchOptions = table.shown
  .map((r) => r.branch)
  .map((b) => ({ value: b.name, label: b.eol ? `${b.name} (end of life)` : b.name }));
---

<Base
  title={`${product.name} security advisories`}
  description={`${product.name}: check whether your version is affected, the release that fixes it, and ${plural(advisories.length, 'security advisory', 'security advisories')} per release branch.`}
  section="products"
  product={product.slug}
  feed={{ path: productFeedPath(product.slug), title: `${product.name} advisories (Atom)` }}
>
  <header>
    <Crumbs
      items={[
        { label: category.name, path: categoryPath(product.category) },
        { label: product.name },
      ]}
    />
    <h1 class="page-title">{product.name}</h1>
    <p class="meta">
      <span>
        <strong>{lastYear}</strong> {lastYear === 1 ? 'advisory' : 'advisories'} in the last 12
        months
      </span>
      {primary && (
        <span>
          Ranges from {primary.label}, {primary.detail}
        </span>
      )}
      <a href={product.homepage} rel="noopener noreferrer">
        {product.homepage.replace(/^https?:\/\//, '')}
      </a>
      <a href={href(productFeedPath(product.slug))}>Atom feed</a>
    </p>
  </header>

  <VersionCheck product={product} />

  <section class="section" aria-labelledby="br-title">
    <div class="section-head">
      <h2 class="section-title" id="br-title">
        Branches
      </h2>
      {product.branchSource === 'endoflife' && (
        <span class="section-sub">Support dates from endoflife.date</span>
      )}
    </div>
    {product.branches.length === 0 ? (
      <div class="empty">
        <p class="empty-title">No release branches listed</p>
        <p>
          {product.name} has no branch data on endoflife.date, so versions are compared directly.
          Give the check above and the notifier your exact version.
        </p>
      </div>
    ) : (
      <BranchTable table={table} productName={product.name} />
    )}
  </section>

  <section class="section" aria-labelledby="list-title" id="list">
    <div class="section-head">
      <h2 class="section-title" id="list-title">
        Advisories
      </h2>
      <span class="section-sub">Grouped by the release that fixed them</span>
    </div>
    {advisories.length === 0 ? (
      <div class="empty">
        <p class="empty-title">No advisories yet</p>
        <p>
          The feed has no advisory for {product.name} in the last 12 months. The notifier will post
          the first one that matches your version.
        </p>
      </div>
    ) : (
      <>
        <Filters
          name="psev"
          label="Filter advisories"
          counts={counts}
          total={advisories.length}
          select={{
            filter: 'branch',
            label: 'Branch',
            all: 'All branches',
            options: branchOptions,
          }}
        />
        <div class="releases" data-feed>
          {releases.map((bundle, i) => (
            <ReleaseBundle bundle={bundle} open={i === 0} preview={7} label="day" />
          ))}
          <p class="empty" data-filter-empty hidden>
            <span class="empty-title">No advisory matches these filters</span>
            <span>Pick All to see every advisory of {product.name}.</span>
          </p>
        </div>
      </>
    )}
  </section>

  <section class="section" aria-labelledby="src-title">
    <h2 class="section-title section-title--gap" id="src-title">
      Sources and licenses
    </h2>
    <ul class="sources">
      {sources.map((s) => (
        <li>
          <span>
            {s.url ? (
              <a href={s.url} rel="noopener noreferrer">
                {s.label}
              </a>
            ) : (
              s.label
            )}
            <span class="muted">, {s.detail}</span>
          </span>
          <span class="lic">
            {s.crossCheckOnly
              ? 'Read as a cross-check, nothing copied'
              : s.attribution
                ? s.attribution.license
                : 'Linked, not copied'}
          </span>
        </li>
      ))}
    </ul>
    <p class="hint section-foot">
      <a href={href('sources/')}>All data sources and their terms</a>
    </p>
  </section>
</Base>

<script>
  import { startBundles, startFilters } from '../../../scripts/bundles.ts';

  startBundles();
  const form = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-feed]');
  if (form !== null && list !== null) startFilters(form, list);

  // Older end-of-life branches fold behind "Show them".
  const toggle = document.querySelector<HTMLButtonElement>('[data-older-toggle]');
  if (toggle !== null) {
    const older = [...document.querySelectorAll<HTMLElement>('[data-older]')];
    const set = (open: boolean): void => {
      for (const row of older) row.hidden = !open && !row.classList.contains('is-yours');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.textContent = open ? 'Hide them' : 'Show them';
    };
    set(false);
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      set(toggle.getAttribute('aria-expanded') !== 'true');
    });
  }
</script>
