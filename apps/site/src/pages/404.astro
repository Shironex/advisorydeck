---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site.ts';
---

<Base title="Not found" description="This page does not exist.">
  <header>
    <h1 class="page-title">Not found</h1>
    <p class="lede">
      This page does not exist. Advisories live at{' '}
      <code class="code-inline">advisories/&lt;id&gt;/</code>; try the{' '}
      <a href={href('advisories/')}>list of all advisories</a> or the{' '}
      <a href={href('products/')}>products</a>.
    </p>
  </header>
</Base>
