{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@schemas/*": ["../../schemas/v1/*"]
    }
  },
  "include": [".astro/types.d.ts", "src", "test", "scripts", "*.ts", "*.mjs"],
  "exclude": ["dist"]
}
