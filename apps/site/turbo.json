{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/catalog/**",
        "$TURBO_ROOT$/data/**",
        "$TURBO_ROOT$/notes/**",
        "$TURBO_ROOT$/schemas/**"
      ],
      "env": ["SITE_URL", "SITE_BASE", "ADVISORYDECK_ROOT"],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/catalog/**",
        "$TURBO_ROOT$/data/**",
        "$TURBO_ROOT$/notes/**",
        "$TURBO_ROOT$/schemas/**",
        "$TURBO_ROOT$/docs/examples/**"
      ]
    }
  }
}
