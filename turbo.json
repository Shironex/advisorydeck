{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["ASTRO_TELEMETRY_DISABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/catalog/**",
        "$TURBO_ROOT$/schemas/**",
        "$TURBO_ROOT$/fixtures/**",
        "$TURBO_ROOT$/notes/**"
      ]
    }
  }
}
