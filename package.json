{
  "name": "advisorydeck",
  "private": true,
  "description": "Security advisories for the software self-hosters run, with reviewed notes and a tiny notifier image.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint && eslint --max-warnings=0 *.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm --filter @advisorydeck/contract run validate",
    "ingest": "pnpm --filter @advisorydeck/ingest run ingest",
    "catalog:suggest": "pnpm --filter @advisorydeck/ingest run catalog:suggest",
    "gen:types": "pnpm --filter @advisorydeck/contract run gen:types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
