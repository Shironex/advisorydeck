    {
      "id": "CVE-2026-42154",
      "aliases": [
        "GHSA-8rm2-7qqf-34qm"
      ],
      "title": "Prometheus: remote read endpoint allows denial of service via crafted snappy payload",
      "summary": "Prometheus is an open-source monitoring system and time series database. Prior to versions 3.5.3 and 3.11.3, the remote read endpoint (/api/v1/read) does not validate the declared decoded length in a snappy-compressed request body before allocating memory. An unauthenticated attacker can send a small payload that causes a huge heap allocation per request. Under concurrent load this can exhaust available memory and crash the Prometheus process. This issue has been patched in versions 3.5.3 and 3.11.3.",
      "published_at": "2026-04-27T14:51:22.000Z",
      "modified_at": "2026-09-10T12:04:54.339Z",
