    {
      "id": "CVE-2026-33540",
      "aliases": [
        "GHSA-3p65-76g6-3w7r"
      ],
      "title": "Distribution affected by pull-through cache credential exfiltration via www-authenticate bearer realm",
      "summary": "Distribution is a toolkit to pack, ship, store, and deliver container content. Prior to 3.1.0, in pull-through cache mode, distribution discovers token auth endpoints by parsing WWW-Authenticate challenges returned by the configured upstream registry. The realm URL from a bearer challenge is used without validating that it matches the upstream registry host. As a result, an attacker-controlled upstream (or an attacker with MitM position to the upstream) can cause distribution to send the configured upstream credentials via basic auth to an attacker-controlled realm URL. This vulnerability is fixed in 3.1.0.",
      "published_at": "2026-04-06T13:59:09.000Z",
      "modified_at": "2026-04-06T23:42:46.000Z",
      "severity": {
